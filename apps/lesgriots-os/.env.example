# ═══════════════════════════════════════════════════════════════════════
# LES GRIOTS OS — Variables d'environnement (modèle)
# ═══════════════════════════════════════════════════════════════════════
#
# En local  : copier ce fichier vers `.env.local` et remplir les valeurs.
# En prod   : les valeurs vivent dans `/etc/lesgriots-os.env` (hors-Git,
#             chmod 600, chargé par systemd via EnvironmentFile).
#             Voir lesgriots-platform/docs/DEPLOY-OS.md.
#
# ⚠️ Ne JAMAIS commiter un fichier contenant de vraies valeurs.
#    Les vraies valeurs vont dans un gestionnaire de mots de passe
#    (cf. lesgriots-platform/docs/SECRETS.md).

# ── Runtime ──────────────────────────────────────────────────────────────

# production sur le VPS, development en local (npm run dev l'ignore de toute façon)
NODE_ENV=production

# Port d'écoute de `next start`. Convention écosystème :
#   3030 = BO Studio · 3031 = BO Griothèque · 3010 = LES GRIOTS OS
PORT=3010

# ── Authentification de l'app ────────────────────────────────────────────

# Active le middleware d'auth (cookie `griot_session` + header `x-api-key`).
# false (ou absent) = app ouverte → UNIQUEMENT en dev local.
# ⚠️ DOIT être `true` en production.
AUTH_ENABLED=true

# Secret de signature des sessions.
# Générer avec :  openssl rand -hex 32
AUTH_SECRET=

# Clé API pour le serveur MCP et les clients machine (header `x-api-key`).
# Générer avec :  openssl rand -hex 32
# La même valeur est à passer au MCP côté client (mcp-server.js).
OS_API_KEY=

# ── Google OAuth (login des utilisateurs) ────────────────────────────────
# Créer un client "Web application" sur
# https://console.cloud.google.com/apis/credentials
# et déclarer l'URI de redirection autorisée :
#   local : http://localhost:3000/api/auth/google  (port par défaut de `next dev`)
#   prod  : https://os.lesgriots.com/api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL de base publique de l'app (utilisée pour construire le redirect OAuth).
#   local : http://localhost:3000
#   prod  : https://os.lesgriots.com
NEXTAUTH_URL=https://os.lesgriots.com
