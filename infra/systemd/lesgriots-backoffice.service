# Service systemd pour le BO Les Griots (site ombrelle) — Next.js
# À copier sur le VPS dans /etc/systemd/system/lesgriots-backoffice.service
# puis :
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lesgriots-backoffice
#
# Exposé par nginx sous https://admin.lesgriots.com/lesgriots/ (basePath "/lesgriots").
# Logs : sudo journalctl -u lesgriots-backoffice -f

[Unit]
Description=LES GRIOTS — Back Office Les Griots (Next.js)
After=network.target

[Service]
Type=simple
User=deployment
WorkingDirectory=/var/www/ecosystem/production/lesgriots-platform/apps/backoffice-lesgriots
# Variables d'environnement (ADMIN_PASSWORD, R2, etc.) hors-Git
EnvironmentFile=-/etc/lesgriots-backoffice.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3032

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/ecosystem/production/lesgriots-platform/apps/backoffice-lesgriots
ProtectHome=true

[Install]
WantedBy=multi-user.target
