#!/bin/sh
# Pose (ou remplace) les secrets Griot DM dans /etc/lagriotheque-backoffice.env.
# Usage, depuis le Terminal du Mac :  ssh -t debian@51.210.4.77 sudo pose-secrets-griotdm
# Rien n'est affiché à l'écran ; une valeur laissée vide garde l'ancienne.
set -e
ENV=/etc/lagriotheque-backoffice.env
[ "$(id -u)" = 0 ] || { echo "Lancer avec sudo"; exit 1; }
cp "$ENV" "$ENV.bak-griotdm-$(date +%Y%m%d-%H%M%S)"
setvar() {
  key="$1"; val="$2"
  [ -z "$val" ] && return 0
  grep -v "^$key=" "$ENV" > "$ENV.tmp" || true
  printf '%s=%s\n' "$key" "$val" >> "$ENV.tmp"
  cat "$ENV.tmp" > "$ENV"; rm -f "$ENV.tmp"
  echo "  $key posé"
}
ask() { printf '%s : ' "$1" >&2; stty -echo 2>/dev/null; read -r v; stty echo 2>/dev/null; echo >&2; printf '%s' "$v"; }
check() { # $1=nom $2=valeur $3=regex $4=aide
  [ -z "$2" ] && return 0
  printf '%s' "$2" | grep -Eq "$3" && return 0
  echo "  ✗ $1 refusé : $4 (reçu ${#2} caractères, commence par « $(printf '%s' "$2" | cut -c1-2)… »)" >&2
  return 1
}
echo "Secrets Griot DM (Entrée = garder l'actuel)"
v=$(ask 'Clé secrète Instagram (32 caractères a-f/0-9, bouton Afficher)')
check IG_APP_SECRET "$v" '^[0-9a-f]{32}$' "attendu 32 caractères hexadécimaux" && setvar IG_APP_SECRET "$v"
v=$(ask "Jeton d'accès (très long, commence par IG)")
check IG_ACCESS_TOKEN "$v" '^IG[A-Za-z0-9_-]{100,}$' "attendu une longue chaîne commençant par IG" && setvar IG_ACCESS_TOKEN "$v"
v=$(printf '%s' "$(ask 'ID du compte Instagram (17 chiffres, ex. 1784…)')" | tr -d ' ')
check IG_USER_ID "$v" '^[0-9]{15,20}$' "attendu uniquement des chiffres" && setvar IG_USER_ID "$v"
grep -q '^IG_VERIFY_TOKEN=' "$ENV" || setvar IG_VERIFY_TOKEN "$(openssl rand -hex 16)"
chmod 600 "$ENV"
systemctl restart lagriotheque-backoffice
echo "OK — BO Griothèque redémarré."
